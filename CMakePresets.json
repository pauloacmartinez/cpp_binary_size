{
    "version": 3,
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_BUILD_TYPE": "MinSizeRel"
            }
        },
        {
            "name": "stm32f4",
            "inherits": "base",
            "toolchainFile": "${sourceDir}/cmake/toolchain/stm32f4.cmake",
            "cacheVariables": {
                "platform": "stm32f4"
            }
        },
        {
            "name": "stm32f4-mold",
            "inherits": "stm32f4",
            "cacheVariables": {
                "MOLD_LINKER": "ON"
            }
        },
        {
            "name": "ra4m1",
            "inherits": "base",
            "toolchainFile": "${sourceDir}/cmake/toolchain/ra4m1.cmake",
            "cacheVariables": {
                "platform": "ra4m1"
            }
        },
        {
            "name": "rv32imac",
            "inherits": "base",
            "toolchainFile": "${sourceDir}/cmake/toolchain/rv32imac.cmake",
            "cacheVariables": {
                "platform": "rv32imac"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "stm32f4-mold",
            "configurePreset": "stm32f4-mold"
        },
        {
            "name": "stm32f4",
            "configurePreset": "stm32f4"
        },
        {
            "name": "ra4m1",
            "configurePreset": "ra4m1"
        },
        {
            "name": "rv32imac",
            "configurePreset": "rv32imac"
        }
    ]
}
